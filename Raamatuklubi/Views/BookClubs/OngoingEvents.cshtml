@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@model IEnumerable<Raamatuklubi.Models.BookClubs.OngoingEventsViewModel>
@inject UserManager<Raamatuklubi.Core.Domain.ApplicationUser> userManager

@{
	var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h1>All ongoing events</h1>

<a asp-action="CreateEvent" asp-controller="BookClubs" class="btn btn-primary">Create your own event</a>

<form method="get">

	<table class="table table-hover">
		<thead>
			<tr>
				<th scope="col">Event name</th>
				<th scope="col">Event start date</th>
				<th scope="col">Event end date</th>
				<th scope="col">Options</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var ongoingevent in Model)
			{
				<tr>
					<td>@ongoingevent.EventName</td>
					<td>@ongoingevent.StartTime</td>
					<td>@ongoingevent.EndTime</td>
					<td>
					@if (ongoingevent.Attendees.Contains(currentUserId))
					{
						<a asp-action="UnjoinEvent" asp-controller="BookClubs" class="btn btn-danger" asp-route-id="@ongoingevent.Id">Unjoin from event</a>
					}
					else
					{
						<a asp-action="JoinEvent" asp-controller="BookClubs" class="btn btn-primary" asp-route-id="@ongoingevent.Id">Join event</a>
					}
					</td>
				</tr>
			}
		</tbody>
	</table>
</form>